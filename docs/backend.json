
{
  "entities": {
    "Employee": {
      "title": "Employee",
      "type": "object",
      "description": "Represents an employee within the GeoHRM system.",
      "properties": {
        "id": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["Member", "Team Lead", "HR Manager", "CEO/Admin"] },
        "jobTitle": { "type": "string" },
        "department": { "type": "string" },
        "teamId": { "type": "string" },
        "branchId": { "type": "string" },
        "avatar": { "type": "string" },
        "shiftType": { "type": "string" },
        "reportingHeadIds": { "type": "array", "items": { "type": "string" }, "description": "Array of user IDs representing the managers this employee reports to." },
        "isWfhAllowed": { "type": "boolean" },
        "homeLatitude": { "type": "number" },
        "homeLongitude": { "type": "number" },
        "homeRadius": { "type": "number" },
        "performanceRating": { "type": "string", "enum": ["Excellent", "Good", "Improving", "Poor"] },
        "lastReviewDate": { "type": "string", "format": "date-time" },
        "leaveBalance": { "type": "number" },
        "totalLeaveEntitlement": { "type": "number" },
        "payrollAmount": { "type": "number" },
        "payrollDate": { "type": "string", "format": "date-time" },
        "dob": { "type": "string", "format": "date-time" },
        "gender": { "type": "string" },
        "nationality": { "type": "string" },
        "maritalStatus": { "type": "string" },
        "bloodGroup": { "type": "string" },
        "languages": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "firstName", "lastName", "email", "role"]
    },
    "Branch": {
      "title": "Branch",
      "type": "object",
      "description": "A physical office location with geofencing data.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "address": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "radius": { "type": "number" }
      },
      "required": ["id", "name", "latitude", "longitude"]
    },
    "Asset": {
      "title": "Asset",
      "type": "object",
      "description": "Physical company resources like laptops and devices.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "specs": { "type": "string" },
        "imageUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["Available", "Assigned", "Maintenance"] },
        "assignedToId": { "type": "string" }
      },
      "required": ["id", "name", "category", "status"]
    },
    "AssetRequest": {
      "title": "AssetRequest",
      "type": "object",
      "description": "A request for a company asset.",
      "properties": {
        "id": { "type": "string" },
        "assetId": { "type": "string" },
        "requesterId": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Rejected"] },
        "reason": { "type": "string" },
        "requestDate": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "assetId", "requesterId", "status"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/branches/{branchId}",
        "definition": {
          "entityName": "Branch",
          "description": "Registry of office branches."
        }
      },
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "Employee",
          "description": "Global user registry."
        }
      },
      {
        "path": "/assets/{assetId}",
        "definition": {
          "entityName": "Asset",
          "description": "Global inventory of physical assets."
        }
      },
      {
        "path": "/asset_requests/{requestId}",
        "definition": {
          "entityName": "AssetRequest",
          "description": "Global log of asset allocation requests."
        }
      }
    ]
  }
}
