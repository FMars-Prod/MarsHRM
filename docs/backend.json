
{
  "entities": {
    "Employee": {
      "title": "Employee",
      "type": "object",
      "description": "Represents an employee within the GeoHRM system.",
      "properties": {
        "id": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["Member", "Team Lead", "HR Manager", "CEO/Admin"] },
        "jobTitle": { "type": "string" },
        "department": { "type": "string" },
        "teamId": { "type": "string" },
        "avatar": { "type": "string" }
      },
      "required": ["id", "firstName", "lastName", "email", "role"]
    },
    "Asset": {
      "title": "Asset",
      "type": "object",
      "description": "Physical company resources like laptops and devices.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "specs": { "type": "string" },
        "imageUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["Available", "Assigned", "Maintenance"] },
        "assignedToId": { "type": "string" }
      },
      "required": ["id", "name", "category", "status"]
    },
    "AssetRequest": {
      "title": "AssetRequest",
      "type": "object",
      "description": "A request for a company asset.",
      "properties": {
        "id": { "type": "string" },
        "assetId": { "type": "string" },
        "requesterId": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Rejected"] },
        "reason": { "type": "string" },
        "requestDate": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "assetId", "requesterId", "status"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}/documents/{documentId}",
        "definition": {
          "entityName": "Document",
          "description": "Subcollection for employee assets."
        }
      },
      {
        "path": "/assets/{assetId}",
        "definition": {
          "entityName": "Asset",
          "description": "Global inventory of physical assets."
        }
      },
      {
        "path": "/asset_requests/{requestId}",
        "definition": {
          "entityName": "AssetRequest",
          "description": "Global log of asset allocation requests."
        }
      }
    ]
  }
}
