
rules_version = '2';

function isOwner(userId) {
  return request.auth != null && request.auth.uid == userId;
}

function isCEO() {
  return exists(/databases/$(database)/documents/roles_ceo/$(request.auth.uid));
}

function isHR() {
  return exists(/databases/$(database)/documents/roles_hr_agent/$(request.auth.uid));
}

function isTeamLead() {
  return exists(/databases/$(database)/documents/roles_team_lead/$(request.auth.uid));
}

function isTeamLeadOf(employeeId) {
    if (!isTeamLead()) {
        return false;
    }
    let employeeTeamId = get(/databases/$(database)/documents/users/$(employeeId)).data.teamId;
    if (employeeTeamId == null) {
        return false;
    }
    // Check if the team lead is the lead of the employee's team.
    let team = get(/databases/$(database)/documents/teams/$(employeeTeamId)).data;
    return team.teamLeadId == request.auth.uid;
}

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if isOwner(userId) || isCEO() || isHR() || isTeamLeadOf(userId);
      allow write: if isOwner(userId) || isCEO() || isHR();
    }

    match /teams/{teamId} {
      allow read: if isCEO() || isHR() || get(/databases/$(database)/documents/teams/$(teamId)).data.teamLeadId == request.auth.uid;
      allow write: if isCEO() || isHR();
    }

    match /users/{userId}/attendances/{attendanceId} {
      allow read, write: if isOwner(userId) || isCEO() || isHR() || isTeamLeadOf(userId);
    }
    
    match /users/{userId}/leave_requests/{leaveRequestId} {
      allow read, write: if isOwner(userId) || isCEO() || isHR() || isTeamLeadOf(userId);
    }

    match /users/{userId}/reports/{reportId} {
      allow read, write: if isOwner(userId) || isCEO() || isHR() || isTeamLeadOf(userId);
    }

    match /users/{userId}/payslips/{payslipId} {
      allow read: if isOwner(userId) || isCEO() || isHR();
      allow write: if isCEO() || isHR();
    }
    
    match /announcements/{announcementId} {
        allow read: if request.auth != null;
        allow write: if isCEO() || isHR();
    }
    
    match /events/{eventId} {
        allow read: if request.auth != null;
        allow write: if isCEO() || isHR();
    }
    
    match /policies/{policyId} {
        allow read: if request.auth != null;
        allow write: if isCEO() || isHR();
    }
    
    match /users/{userId}/policy_acknowledgments/{acknowledgmentId} {
        allow read, write: if isOwner(userId);
    }
    
    match /issue_reports/{issueReportId} {
        allow read, write: if isOwner(get(/databases/$(database)/documents/issue_reports/$(issueReportId)).data.employeeId) || isCEO() || isHR();
    }

    match /audit_logs/{auditLogId} {
        allow read, write: if isCEO();
    }
    
    match /settings/{settingId} {
        allow read: if request.auth != null;
        allow write: if isCEO() || isHR();
    }

    // Role documents for quick checks
    match /roles_ceo/{userId} {
      allow read, write: if isCEO();
    }
    match /roles_admin/{userId} {
      allow read, write: if isCEO();
    }
    match /roles_hr_agent/{userId} {
       allow read, write: if isCEO() || isHR();
    }
    match /roles_team_lead/{userId} {
      allow read, write: if isCEO() || isHR();
    }
  }
}
