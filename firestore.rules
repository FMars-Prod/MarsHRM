
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/system_roles_admin/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'CEO/Admin'
      );
    }

    function isHR() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/system_roles_hr/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'HR Manager'
      );
    }

    function isPrivileged() {
      return isAdmin() || isHR();
    }

    match /employees/{employeeId} {
      allow get, list: if isSignedIn();
      allow create: if isOwner(employeeId);
      allow update: if isOwner(employeeId) || isPrivileged();
      allow delete: if isPrivileged();
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) || isPrivileged();
      allow update: if isOwner(userId) || isPrivileged();
      allow delete: if isPrivileged();

      match /attendances/{attId} {
        allow read: if isOwner(userId) || isPrivileged();
        allow write: if isOwner(userId) || isPrivileged();
      }
      
      match /reports/{reportId} {
        allow read: if isOwner(userId) || isPrivileged();
        allow create: if isOwner(userId);
        allow delete: if isPrivileged();
      }

      match /documents/{docId} {
        allow read: if isOwner(userId) || isPrivileged();
        allow write: if isOwner(userId) || isPrivileged();
      }

      match /todos/{todoId} {
        allow read: if isOwner(userId) || resource.data.assignedBy == request.auth.uid;
        allow create: if isSignedIn() && (isOwner(userId) || request.resource.data.assignedBy == request.auth.uid);
        allow update: if isOwner(userId) || resource.data.assignedBy == request.auth.uid;
        allow delete: if (isOwner(userId) || resource.data.assignedBy == request.auth.uid);
      }

      match /readAnnouncements/{id} {
        allow read, write: if isOwner(userId);
      }

      match /policy_acknowledgments/{id} {
        allow read, write: if isOwner(userId);
      }
    }
    
    match /{path=**}/reports/{reportId} {
        allow read: if isSignedIn() && (isPrivileged() || resource.data.employeeId == request.auth.uid);
    }
    
    match /{path=**}/attendances/{attId} {
        allow read: if isSignedIn() && (isPrivileged() || resource.data.employeeId == request.auth.uid);
    }

    match /assets/{id} {
      allow read: if isSignedIn();
      allow write: if isPrivileged();
    }

    match /asset_requests/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isPrivileged();
      allow delete: if isPrivileged();
    }

    match /settings/{id} {
      allow read: if isSignedIn();
      allow write: if isPrivileged();
    }

    match /teams/{id} {
      allow read: if isSignedIn();
      allow write: if isPrivileged();
    }

    match /leave_requests/{id} {
      allow read: if isSignedIn(); 
      allow create: if isSignedIn();
      allow update: if isPrivileged();
      allow delete: if isPrivileged();
    }

    match /announcements/{id} {
      allow read: if isSignedIn();
      allow write: if isPrivileged();
    }
    
    match /issue_reports/{id} {
      allow read: if isSignedIn(); 
      allow create: if isSignedIn();
      allow update: if isPrivileged();
      allow delete: if isPrivileged();
    }

    match /events/{id} {
      allow read: if isSignedIn();
      allow write: if isPrivileged();
      allow update: if isSignedIn();
    }

    match /holidays/{id} {
      allow read: if isSignedIn();
      allow write: if isPrivileged();
    }

    match /compliance_reports/{id} {
      allow read, write: if isPrivileged();
    }

    match /payslips/{id} {
      allow read: if isSignedIn() && (isPrivileged() || resource.data.employeeId == request.auth.uid);
      allow write: if isPrivileged();
    }

    match /policies/{id} {
      allow read: if isSignedIn();
      allow write: if isPrivileged();
    }

    match /attendanceApprovalRequests/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isPrivileged();
      allow delete: if isPrivileged();
    }

    match /location_change_requests/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isPrivileged();
      allow delete: if isPrivileged();
    }
  }
}
