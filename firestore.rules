/**
 * Core Philosophy: This ruleset enforces a hybrid security model that combines
 * strict user-ownership with role-based access control (RBAC). Personal employee
 * data is private to the individual user, while administrative roles (Admin, CEO,
 * HR, Team Lead) are granted elevated privileges for management and oversight.
 *
 * Data Structure:
 * - User-specific data (attendance, leave requests) is nested under /users/{userId},
 *   ensuring a clear ownership chain.
 * - Global data (announcements, policies) is stored in top-level collections for
 *   company-wide access.
 * - Roles are managed through dedicated top-level collections (e.g., /roles_admin/{userId}).
 *   This "Existence over Content" pattern allows for highly efficient and secure
 *   role checks without needing to read a user's profile document.
 *
 * Key Security Decisions:
 * - Default Deny: All paths are closed by default. Access is granted explicitly.
 * - User Privacy: Users can only access their own data within their /users/{userId} tree.
 *   Listing of all users is disallowed to prevent user enumeration.
 * - Role-Based Authorization: Administrative actions are restricted to users whose UID
 *   exists in a corresponding /roles_* collection. This avoids storing roles on the
 *   user document, which would require insecure or slow `get()` calls in rules.
 * - Admin/CEO Oversight: Admin and CEO roles have broad read access to user data for
 *   management and auditing purposes, but write access remains controlled.
 * - Client-Side Writes: Destructive or sensitive operations, like creating audit logs
 *   or managing roles, are restricted to prevent direct client manipulation.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------
    // Helper Functions
    // --------------------------------

    /**
     * Checks if a user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the currently authenticated user's UID matches the provided userId.
     * This is the foundation of the ownership model.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Checks if a document being operated on already exists.
     * Crucial for all update and delete operations.
     */
    function isExistingDoc() {
      return resource != null;
    }

    /**
     * Role Check: Verifies if the user has the Admin role.
     * Uses an efficient `exists()` check on a dedicated role collection.
     */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * Role Check: Verifies if the user has the CEO role.
     */
    function isCeo() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_ceo/$(request.auth.uid));
    }

    /**
     * Role Check: Verifies if the user has the HR Agent role.
     */
    function isHrAgent() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_hr_agent/$(request.auth.uid));
    }

    /**
     * Role Check: Verifies if the user has the Team Lead role.
     */
    function isTeamLead() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_team_lead/$(request.auth.uid));
    }

    // --------------------------------
    // User and User Subcollections
    // --------------------------------

    /**
     * @description A user can create their own profile, and only they or an admin can read/update it.
     * @path /users/{userId}
     * @allow (create) An authenticated user creates their own profile document with a matching ID.
     * @deny (create) An authenticated user tries to create a profile for another user ID.
     * @principle A user's root document must be creatable by the user themselves.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin() || isCeo();
      allow list: if isAdmin() || isCeo() || isHrAgent();
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isOwner(userId) && isExistingDoc() && request.resource.data.id == resource.data.id;
      allow delete: if false; // User profiles are generally not deletable by the user
    }

    /**
     * @description A user can manage their own attendance records. Admins have read-only access.
     * @path /users/{userId}/attendances/{attendanceId}
     * @allow (create) An authenticated user (auth.uid: 'user123') creates an attendance record for themselves.
     * @deny (get) A user ('user456') tries to read the attendance of 'user123'.
     * @principle Restricts access to a user's own data tree (Ownership).
     */
    match /users/{userId}/attendances/{attendanceId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.employeeId == userId;
      allow update: if isOwner(userId) && isExistingDoc() && request.resource.data.employeeId == resource.data.employeeId;
      allow delete: if isOwner(userId) && isExistingDoc();
    }

    /**
     * @description A user can manage their own leave requests. Admins, HR, and Team Leads can view/update them.
     * @path /users/{userId}/leave_requests/{leaveRequestId}
     * @allow (update) A Team Lead updates the 'status' of a leave request for one of their team members.
     * @deny (create) A user tries to create a leave request on behalf of another user.
     * @principle Combines ownership with role-based access for workflows.
     */
    match /users/{userId}/leave_requests/{leaveRequestId} {
      allow get: if isOwner(userId) || isAdmin() || isHrAgent() || isTeamLead();
      allow list: if isOwner(userId) || isAdmin() || isHrAgent() || isTeamLead();
      allow create: if isOwner(userId) && request.resource.data.employeeId == userId;
      // Note: Team Leads and HR can update for approval workflows.
      allow update: if (isOwner(userId) || isAdmin() || isHrAgent() || isTeamLead()) && isExistingDoc() && request.resource.data.employeeId == resource.data.employeeId;
      allow delete: if isOwner(userId) && isExistingDoc();
    }

    /**
     * @description A user can create and view their own policy acknowledgments. They are immutable once created.
     * @path /users/{userId}/policy_acknowledgments/{acknowledgmentId}
     * @allow (create) A user acknowledges a new company policy.
     * @deny (update) A user tries to change the date of their acknowledgment.
     * @principle Enforces data immutability for records of fact.
     */
    match /users/{userId}/policy_acknowledgments/{acknowledgmentId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.employeeId == userId;
      allow update: if false;
      allow delete: if false;
    }

    // --------------------------------
    // Top-Level Public Collections
    // --------------------------------

    /**
     * @description Announcements are public to all signed-in employees but can only be managed by HR or Admins.
     * @path /announcements/{announcementId}
     * @allow (get) Any authenticated employee can read an announcement.
     * @deny (create) A regular employee tries to post a company-wide announcement.
     * @principle Provides public read access for global data while securing write operations.
     */
    match /announcements/{announcementId} {
      allow get, list: if isSignedIn();
      allow create: if (isAdmin() || isHrAgent()) && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if (isAdmin() || isHrAgent()) && isExistingDoc();
    }

    /**
     * @description Policies are public to all signed-in employees but can only be managed by HR or Admins.
     * @path /policies/{policyId}
     * @allow (list) Any authenticated employee can list all company policies.
     * @deny (delete) A regular employee tries to delete a policy document.
     * @principle Provides public read access for global data while securing write operations.
     */
    match /policies/{policyId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if (isAdmin() || isHrAgent());
    }

    /**
     * @description App settings can be read by any authenticated user but only written by a CEO/Admin.
     * @path /settings/{settingId}
     * @allow (get) Any authenticated user can read settings like office location.
     * @deny (create) A regular employee tries to change a setting.
     * @principle Centralizes configuration and secures it to top-level admins.
     */
    match /settings/{settingId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if isCeo() || isAdmin() || isHrAgent();
    }

    // --------------------------------
    // Top-Level Functional Collections
    // --------------------------------

    /**
     * @description Employees can create their own issue reports. Only the owner or an admin can read/update it. Listing is admin-only.
     * @path /issue_reports/{issueReportId}
     * @allow (create) An employee submits a new issue report, setting their own UID in the 'employeeId' field.
     * @deny (list) A regular employee tries to see all issue reports submitted by others.
     * @principle Enforces document ownership for writes and reads, with admin oversight. Prevents data leakage via list operations.
     */
    match /issue_reports/{issueReportId} {
      allow get: if isOwner(resource.data.employeeId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.employeeId == request.auth.uid;
      allow update: if (isOwner(resource.data.employeeId) || isAdmin()) && isExistingDoc() && request.resource.data.employeeId == resource.data.employeeId;
      allow delete: if isOwner(resource.data.employeeId) && isExistingDoc();
    }

    // --------------------------------
    // Role-Management Collections
    // --------------------------------

    /**
     * @description Defines which users are Team Leads. Only a CEO can manage this list.
     * @path /roles_team_lead/{userId}
     * @allow (create) The CEO grants Team Lead status to a user.
     * @deny (get, list, update) All other operations are denied to prevent enumeration or modification of roles.
     * @principle Manages roles via document existence. Access is highly restricted to prevent privilege escalation.
     */
    match /roles_team_lead/{userId} {
      allow get, list, update: if false;
      allow create, delete: if isCeo();
    }

    /**
     * @description Defines which users are HR Agents. Only a CEO can manage this list.
     * @path /roles_hr_agent/{userId}
     * @allow (create) The CEO grants HR Agent status to a user.
     * @deny (get, list, update) All other operations are denied to prevent enumeration or modification of roles.
     * @principle Manages roles via document existence. Access is highly restricted to prevent privilege escalation.
     */
    match /roles_hr_agent/{userId} {
      allow get, list, update: if false;
      allow create, delete: if isCeo();
    }

    /**
     * @description Defines which users are Admins. Only a CEO can manage this list.
     * @path /roles_admin/{userId}
     * @allow (create) The CEO grants Admin status to a user.
     * @deny (get, list, update) All other operations are denied to prevent enumeration or modification of roles.
     * @principle Manages roles via document existence. Access is highly restricted to prevent privilege escalation.
     */
    match /roles_admin/{userId} {
      allow get, list, update: if false;
      allow create, delete: if isCeo();
    }

    /**
     * @description Defines which users are CEOs. Only a CEO can manage this list (e.g. transfer role).
     * @path /roles_ceo/{userId}
     * @allow (create) The CEO grants CEO status to another user.
     * @deny (get, list, update) All other operations are denied to prevent enumeration or modification of roles.
     * @principle Manages roles via document existence. Access is highly restricted to prevent privilege escalation.
     */
    match /roles_ceo/{userId} {
      allow get, list, update: if false;
      allow create, delete: if isCeo();
    }

    // --------------------------------
    // Restricted Collections
    // --------------------------------

    /**
     * @description Stores audit logs. No client-side writes are allowed. Only Admins/CEOs can read.
     * @path /audit_logs/{auditLogId}
     * @allow (get) An Admin or CEO views an audit log entry for security review.
     * @deny (create) Any client attempts to write directly to the audit log.
     * @principle Protects integrity of audit trails by disallowing all client-side writes.
     */
    match /audit_logs/{auditLogId} {
      allow get, list: if isAdmin() || isCeo();
      allow create, update, delete: if false;
    }
  }
}
