rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // This rule is required to allow the collectionGroup query in the TeamStatusWidget
    match /{path=**}/attendances/{attendanceId} {
      allow get, list: if true;
    }
    
    match /{path=**}/issue_reports/{issue_reportsId} {
      allow get, list: if true;
    }
    
    match /{document=**} {
      allow read, write: if true;
    }
  }
}